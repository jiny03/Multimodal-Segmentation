  "transcript_segments": [
    {
      "start": 0.37,
      "end": 1.67,
      "duration": 1.2999999999999998,
      "text": "Simmer down!"
    },
    {
      "start": 1.67,
      "end": 3.67,
      "duration": 2.0,
      "text": "Thank you. Okay."
    },
    {
      "start": 3.67,
      "end": 6.67,
      "duration": 3.0,
      "text": "Now, I realize that you guys have probably heard"
    },
    {
      "start": 6.67,
      "end": 9.37,
      "duration": 2.6999999999999993,
      "text": "about this other villain who stole the pyramids."
    },
    {
      "start": 9.37,
      "end": 11.87,
      "duration": 2.5,
      "text": "Apparently, it's a big deal."
    },
    {
      "start": 11.87,
      "end": 14.37,
      "duration": 2.5,
      "text": "People are calling it the crime of the century"
    },
    {
      "start": 14.37,
      "end": 15.67,
      "duration": 1.3000000000000007,
      "text": "and stuff like that."
    },
    {
      "start": 15.67,
      "end": 17.87,
      "duration": 2.200000000000001,
      "text": "But am I upset?"
    },
    {
      "start": 17.87,
      "end": 19.87,
      "duration": 2.0,
      "text": "No, I am not."
    },
    {
      "start": 20.87,
      "end": 26.37,
      "duration": 5.5,
      "text": "A little, but we have had a pretty good year ourselves."
    },
    {
      "start": 26.37,
      "end": 29.87,
      "duration": 3.5,
      "text": "And you guys are all writing my book."
    },
    {
      "start": 30.37,
      "end": 32.37,
      "duration": 1.9999999999999964,
      "text": "No, no races"
    },
    {
      "start": 35.81,
      "end": 41.25,
      "duration": 5.439999999999998,
      "text": "What did we do well, we stole the Times Square"
    },
    {
      "start": 55.52,
      "end": 58.48,
      "duration": 2.9599999999999937,
      "text": "We stole the statue of liberty"
    },
    {
      "start": 58.48,
      "end": 62.72,
      "duration": 4.240000000000002,
      "text": "The small ones from Las Vegas."
    },
    {
      "start": 64.24,
      "end": 68.8,
      "duration": 4.560000000000002,
      "text": "And I won't even mention the Eiffel Tower, also Vegas."
    },
    {
      "start": 69.3,
      "end": 72.06,
      "duration": 2.760000000000005,
      "text": "Okay, I wasn't going to tell you about this yet,"
    },
    {
      "start": 72.2,
      "end": 76.94,
      "duration": 4.739999999999995,
      "text": "but I have been working on something very big."
    },
    {
      "start": 77.34,
      "end": 81.96,
      "duration": 4.61999999999999,
      "text": "Something that will blow this pyramid thing out of the water."
    },
    {
      "start": 82.22,
      "end": 86.48,
      "duration": 4.260000000000005,
      "text": "And thanks to the efforts of my good friend, Dr. Nefario..."
    },
    {
      "start": 87.2,
      "end": 88.16,
      "duration": 0.9599999999999937,
      "text": "Thank you!"
    },
    {
      "start": 88.48,
      "end": 97.76,
      "duration": 9.280000000000001,
      "text": "oh there he is freestyling now we have located the shrink ray in a secret lab"
    },
    {
      "start": 97.76,
      "end": 107.36,
      "duration": 9.599999999999994,
      "text": "and once we take this shrink ray we will have the capability to pull off the true crime of the"
    },
    {
      "start": 107.36,
      "end": 117.52,
      "duration": 10.159999999999997,
      "text": "century we are going to steal wait wait i haven't told you what it is yet"
    },
    {
      "start": 121.62,
      "end": 124.72,
      "duration": 3.0999999999999943,
      "text": "Hey, Dave, listen up, please."
    },
    {
      "start": 129.46,
      "end": 132.06,
      "duration": 2.5999999999999943,
      "text": "Next, we are going to steal."
    },
    {
      "start": 133.06,
      "end": 134.58,
      "duration": 1.5200000000000102,
      "text": "Pause for effect."
    },
    {
      "start": 144.26,
      "end": 146.06,
      "duration": 1.8000000000000114,
      "text": "We've been working on this for a while."
    },
    {
      "start": 146.2,
      "end": 148.7,
      "duration": 2.5,
      "text": "It's an anti-gravity scene."
    },
    {
      "start": 154.68,
      "end": 155.56,
      "duration": 0.8799999999999955,
      "text": "I meant to close that."
    },
    {
      "start": 156.38,
      "end": 157.64,
      "duration": 1.259999999999991,
      "text": "He'll be all right, I'm sure."
    },
    {
      "start": 158.14,
      "end": 159.34,
      "duration": 1.200000000000017,
      "text": "Do the effects wear off?"
    },
    {
      "start": 159.86,
      "end": 161.88,
      "duration": 2.019999999999982,
      "text": "Uh, so far, no."
    },
    {
      "start": 162.14,
      "end": 162.86,
      "duration": 0.7200000000000273,
      "text": "No, they don't."
    },
    {
      "start": 164.86,
      "end": 167.74,
      "duration": 2.8799999999999955,
      "text": "And here, of course, is the new weapon you ordered."
    },
    {
      "start": 167.74,
      "end": 174.52,
      "duration": 6.780000000000001,
      "text": "I said dart gun."
    },
    {
      "start": 174.78,
      "end": 176.08,
      "duration": 1.3000000000000114,
      "text": "Not okay."
    },
    {
      "start": 177.14,
      "end": 182.6,
      "duration": 5.460000000000008,
      "text": "Oh, yes, because I was wondering under what circumstances would we use this."
    },
    {
      "start": 182.74,
      "end": 186.92,
      "duration": 4.179999999999978,
      "text": "But anyway, what I really wanted to show you was this."
    },
    {
      "start": 192.21,
      "end": 194.85,
      "duration": 2.6399999999999864,
      "text": "Now those are cooking robots."
    },
    {
      "start": 195.33,
      "end": 201.42,
      "duration": 6.089999999999975,
      "text": "What are you doing here?"
    },
    {
      "start": 201.5,
      "end": 203.14,
      "duration": 1.6399999999999864,
      "text": "I told you to stay in the kitchen."
    },
    {
      "start": 203.66,
      "end": 204.48,
      "duration": 0.8199999999999932,
      "text": "We got bored."
    },
    {
      "start": 204.82,
      "end": 206.02,
      "duration": 1.200000000000017,
      "text": "What is this place?"
    },
    {
      "start": 206.62,
      "end": 207.78,
      "duration": 1.1599999999999966,
      "text": "Can I drink this?"
    },
    {
      "start": 207.78,
      "end": 209.66,
      "duration": 1.8799999999999955,
      "text": "Do you want to explode?"
    },
    {
      "start": 210.06,
      "end": 222.5,
      "duration": 12.439999999999998,
      "text": "get back in the kitchen will you play with us no why because i'm busy doing what um"
    },
    {
      "start": 222.5,
      "end": 230.74,
      "duration": 8.240000000000009,
      "text": "okay okay you got me the dentist thing is more of a hobby in real life i am a spy"
    },
    {
      "start": 230.74,
      "end": 236.18,
      "duration": 5.439999999999998,
      "text": "and it is top secret and you may not tell anybody because if you do what does this do"
    },
    {
      "start": 236.18,
      "end": 251.15,
      "duration": 14.969999999999999,
      "text": "Fix it? Look, it has been disintegrated. By definition, it cannot be fixed."
    },
    {
      "start": 256.66,
      "end": 258.82,
      "duration": 2.159999999999968,
      "text": "That's freaking me out. What is she doing?"
    },
    {
      "start": 258.94,
      "end": 260.84,
      "duration": 1.8999999999999773,
      "text": "She's going to hold her breath until she gets a new one."
    },
    {
      "start": 261.36,
      "end": 265.74,
      "duration": 4.3799999999999955,
      "text": "It is just a toy. Now stop it."
    },
    {
      "start": 269.2,
      "end": 271.12,
      "duration": 1.920000000000016,
      "text": "Okay, okay, I'll fix it."
    },
    {
      "start": 271.42,
      "end": 277.1,
      "duration": 5.680000000000007,
      "text": "Let us play for it."
    },
    {
      "start": 277.1,
      "end": 278.84,
      "duration": 1.7399999999999523,
      "text": "No, no, no. No, no, no, no."
    },
    {
      "start": 278.86,
      "end": 279.56,
      "duration": 0.6999999999999886,
      "text": "Come on!"
    },
    {
      "start": 281.44,
      "end": 283.48,
      "duration": 2.0400000000000205,
      "text": "How much for the fluffy unicorn?"
    },
    {
      "start": 283.48,
      "end": 291.88,
      "duration": 8.399999999999977,
      "text": "Oh, well, it is not for sale, but all you got to do to win it is knock down that little spaceship there."
    },
    {
      "start": 292.66,
      "end": 294.06,
      "duration": 1.3999999999999773,
      "text": "Ha! It's easy!"
    },
    {
      "start": 295.16,
      "end": 323.64,
      "duration": 28.47999999999996,
      "text": "Just one more. I accidentally closed my eyes."
    },
    {
      "start": 345.87,
      "end": 352.45,
      "duration": 6.579999999999984,
      "text": "Whoa, whoa, whoa, whoa. What was that? She hit that. I saw that with my own eyes."
    },
    {
      "start": 352.69,
      "end": 355.37,
      "duration": 2.680000000000007,
      "text": "Hey, buddy, let me explain something to you."
    },
    {
      "start": 355.37,
      "end": 359.89,
      "duration": 4.519999999999982,
      "text": "You see that little tin spaceship? You see how it's not knocked over?"
    },
    {
      "start": 360.07,
      "end": 366.57,
      "duration": 6.5,
      "text": "Do you know what that means professor? It means you don't get the unicorn"
    },
    {
      "start": 366.57,
      "end": 368.57,
      "duration": 2.0,
      "text": "Oh"
    },
    {
      "start": 368.57,
      "end": 370.57,
      "duration": 2.0,
      "text": "Somebody's got a frowny face"
    },
    {
      "start": 370.57,
      "end": 371.57,
      "duration": 1.0,
      "text": "Boom"
    },
    {
      "start": 371.57,
      "end": 375.33,
      "duration": 3.759999999999991,
      "text": "Better luck next time"
    },
    {
      "start": 375.33,
      "end": 376.33,
      "duration": 1.0,
      "text": "Okay"
    },
    {
      "start": 376.33,
      "end": 692.44,
      "duration": 316.11000000000007,
      "text": "My turn"
    },
    {
      "start": 692.44,
      "end": 697.94,
      "duration": 5.5,
      "text": "Is made of candy and sometimes I eat instead of facing my problems"
    },
    {
      "start": 697.94,
      "end": 702.24,
      "duration": 4.2999999999999545,
      "text": "Okay, time for cake"
    },
    {
      "start": 702.24,
      "end": 713.14,
      "duration": 10.899999999999977,
      "text": "Here come little girl"
    },
    {
      "start": 713.14,
      "end": 719.51,
      "duration": 6.3700000000000045,
      "text": "It was really you, Guru. I'm just pretending for the other kids."
    },
    {
      "start": 719.77,
      "end": 727.11,
      "duration": 7.340000000000032,
      "text": "Mr. Life of the Party."
    },
    {
      "start": 727.97,
      "end": 729.01,
      "duration": 1.0399999999999636,
      "text": "Hello, Jillian."
    },
    {
      "start": 729.45,
      "end": 737.99,
      "duration": 8.539999999999964,
      "text": "Slim here, but my friend Natalie is recently single, and..."
    },
    {
      "start": 737.99,
      "end": 741.59,
      "duration": 3.6000000000000227,
      "text": "No, no, no. Get off the limb right now. No limb."
    },
    {
      "start": 741.69,
      "end": 743.73,
      "duration": 2.0399999999999636,
      "text": "Oh, come on. She's a riot."
    },
    {
      "start": 744.13,
      "end": 747.07,
      "duration": 2.9400000000000546,
      "text": "She sings karaoke. She has a lot of free time."
    },
    {
      "start": 747.07,
      "end": 749.05,
      "duration": 1.9799999999999045,
      "text": "Looks aren't that important to her."
    },
    {
      "start": 750.03,
      "end": 753.19,
      "duration": 3.160000000000082,
      "text": "No, Jill, that is not happening. Seriously."
    },
    {
      "start": 753.41,
      "end": 753.97,
      "duration": 0.5600000000000591,
      "text": "I'm fine."
    },
    {
      "start": 754.21,
      "end": 755.37,
      "duration": 1.1599999999999682,
      "text": "Okay, fine. Forget Natalie."
    },
    {
      "start": 755.71,
      "end": 756.83,
      "duration": 1.1200000000000045,
      "text": "How about my cousin Linda?"
    },
    {
      "start": 756.91,
      "end": 757.19,
      "duration": 0.2800000000000864,
      "text": "No."
    },
    {
      "start": 757.77,
      "end": 760.41,
      "duration": 2.6399999999999864,
      "text": "Oh, oh, I know someone whose husband just died."
    },
    {
      "start": 761.31,
      "end": 765.53,
      "duration": 4.220000000000027,
      "text": "I'm sorry, I did not see you there."
    },
    {
      "start": 765.87,
      "end": 768.16,
      "duration": 2.2899999999999636,
      "text": "Or there."
    },
    {
      "start": 768.52,
      "end": 804.98,
      "duration": 36.460000000000036,
      "text": "Checking for laser beam alarm triggers."
    },
    {
      "start": 806.82,
      "end": 807.8,
      "duration": 0.9799999999999045,
      "text": "It's a restaurant!"
    },
    {
      "start": 808.16,
      "end": 810.4,
      "duration": 2.240000000000009,
      "text": "Do you never know what kind of booby traps this guy could have set?"
    },
    {
      "start": 810.8,
      "end": 811.6,
      "duration": 0.8000000000000682,
      "text": "Huh? Come on."
    },
    {
      "start": 811.66,
      "end": 813.58,
      "duration": 1.9200000000000728,
      "text": "There are no booby traps."
    },
    {
      "start": 814.22,
      "end": 816.1,
      "duration": 1.8799999999999955,
      "text": "Booby!"
    },
    {
      "start": 816.54,
      "end": 828.69,
      "duration": 12.150000000000091,
      "text": "There's a chicken."
    },
    {
      "start": 829.57,
      "end": 831.53,
      "duration": 1.9599999999999227,
      "text": "Are you lost, little guy?"
    },
    {
      "start": 831.91,
      "end": 833.55,
      "duration": 1.6399999999999864,
      "text": "You must be lost."
    },
    {
      "start": 834.45,
      "end": 983.03,
      "duration": 148.57999999999993,
      "text": "That polo is loco, no? Okay, let's go."
    },
    {
      "start": 983.03,
      "end": 1244.5,
      "duration": 261.47,
      "text": "Was that wrong? To my minions! Let me show you."
    },
    {
      "start": 1244.5,
      "end": 1269.89,
      "duration": 25.3900000000001,
      "text": "A little macho thing, huh? This is unexpected."
    },
    {
      "start": 1269.89,
      "end": 1272.37,
      "duration": 2.479999999999791,
      "text": "Well, you never got to go on a honeymoon, so..."
    },
    {
      "start": 1272.37,
      "end": 1273.49,
      "duration": 1.1200000000001182,
      "text": "We made you dinner!"
    },
    {
      "start": 1273.49,
      "end": 1277.43,
      "duration": 3.9400000000000546,
      "text": "We've got pineapples and coconuts and ukulele!"
    },
    {
      "start": 1277.43,
      "end": 1278.93,
      "duration": 1.5,
      "text": "Oh, yay!"
    },
    {
      "start": 1290.93,
      "end": 1295.42,
      "duration": 4.490000000000009,
      "text": "Soup of the day!"
    },
    {
      "start": 1295.42,
      "end": 1299.42,
      "duration": 4.0,
      "text": "Madame and Monsieur, the gummy bears were my idea."
    },
    {
      "start": 1299.42,
      "end": 1308.38,
      "duration": 8.960000000000036,
      "text": "Looks too good to even eat, am I right?"
    },
    {
      "start": 1309.38,
      "end": 1311.38,
      "duration": 2.0,
      "text": "But I made it for you."
    },
    {
      "start": 1311.38,
      "end": 1316.25,
      "duration": 4.869999999999891,
      "text": "Oh."
    },
    {
      "start": 1354.18,
      "end": 1356.18,
      "duration": 2.0,
      "text": "No, no, no, no, no."
    },
    {
      "start": 1356.18,
      "end": 1358.18,
      "duration": 2.0,
      "text": "Yes."
    },
    {
      "start": 1358.18,
      "end": 1360.18,
      "duration": 2.0,
      "text": "But don't worry."
    },
    {
      "start": 1360.18,
      "end": 1363.18,
      "duration": 3.0,
      "text": "I'm sure we'll get new jobs real soon."
    },
    {
      "start": 1363.18,
      "end": 1364.18,
      "duration": 1.0,
      "text": "Even better ones."
    },
    {
      "start": 1364.18,
      "end": 1368.18,
      "duration": 4.0,
      "text": "What's better than being super cool secret agents?"
    },
    {
      "start": 1368.18,
      "end": 1372.18,
      "duration": 4.0,
      "text": "Oh, I know. You could gamble online."
    },
    {
      "start": 1372.18,
      "end": 1374.18,
      "duration": 2.0,
      "text": "That's what Katie's dad does."
    },
    {
      "start": 1374.18,
      "end": 1377.18,
      "duration": 3.0,
      "text": "Okay, we will definitely look into that."
    },
    {
      "start": 1377.18,
      "end": 1379.18,
      "duration": 2.0,
      "text": "That's a good suggestion."
    },
    {
      "start": 1379.18,
      "end": 1382.18,
      "duration": 3.0,
      "text": "And let's not go over to Katie's house anymore."
    },
    {
      "start": 1382.18,
      "end": 1387.64,
      "duration": 5.460000000000036,
      "text": "Hey, Belle, the pastiki, the papaya, not the potato."
    },
    {
      "start": 1387.64,
      "end": 1391.47,
      "duration": 3.8299999999999272,
      "text": "Hey, Belle, the pizza to eat."
    },
    {
      "start": 1391.47,
      "end": 1392.47,
      "duration": 1.0,
      "text": "We eat the spaghetti."
    },
    {
      "start": 1392.47,
      "end": 1414.4,
      "duration": 21.930000000000064,
      "text": "Don't move!"
    },
    {
      "start": 1414.4,
      "end": 1425.22,
      "duration": 10.819999999999936,
      "text": "Hey!"
    },
    {
      "start": 1425.22,
      "end": 1426.22,
      "duration": 1.0,
      "text": "The carbonara."
    },
    {
      "start": 1448.16,
      "end": 1453.61,
      "duration": 5.449999999999818,
      "text": "Try to make friends."
    },
    {
      "start": 1453.61,
      "end": 1455.61,
      "duration": 2.0,
      "text": "Want a Dorito?"
    },
    {
      "start": 1455.61,
      "end": 1456.61,
      "duration": 1.0,
      "text": "Hey, everyone!"
    },
    {
      "start": 1456.61,
      "end": 1458.61,
      "duration": 2.0,
      "text": "The Nuka's handing out Doritos!"
    },
    {
      "start": 1458.61,
      "end": 1459.61,
      "duration": 1.0,
      "text": "Doritos?"
    },
    {
      "start": 1464.97,
      "end": 1478.91,
      "duration": 13.940000000000055,
      "text": "You make friends."
    },
    {
      "start": 1478.91,
      "end": 1480.91,
      "duration": 2.0,
      "text": "Uh..."
    },
    {
      "start": 1480.91,
      "end": 1483.31,
      "duration": 2.3999999999998636,
      "text": "Pito pata milo milata kati kipu letika"
    },
    {
      "start": 1483.31,
      "end": 1485.71,
      "duration": 2.400000000000091,
      "text": "C'est pas la joie des mitokalana moul\u00e9 macarena"
    },
    {
      "start": 1485.71,
      "end": 1488.11,
      "duration": 2.3999999999998636,
      "text": "Pas ol\u00e9thus, pas bo pati, mais les c'est pas macagusta"
    },
    {
      "start": 1488.11,
      "end": 1491.31,
      "duration": 3.2000000000000455,
      "text": "Mamile est belle mais la moustache est la pica moucha"
    },
    {
      "start": 1491.31,
      "end": 1494.11,
      "duration": 2.7999999999999545,
      "text": "Mokako ka pila kaka fissa bella la masala"
    },
    {
      "start": 1494.11,
      "end": 1496.51,
      "duration": 2.400000000000091,
